{
  "schemaVersion": 1,
  "id": "multisolo",
  "version": "${version}",
  "name": "Multisolo",
  "description": "Connected Solitude: seed 0, vanilla spawn, network identity and predefined messages on vanilla signs.",
  "authors": [
    "koka99cab"
  ],
  "contact": {
    "sources": "https://github.com/koka99cab/multisolo",
    "issues": "https://github.com/koka99cab/multisolo/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.koka99cab.multisolo.fabric.Multisolo"
    ],
    "client": [
      "io.github.koka99cab.multisolo.fabric.client.MultisoloClient"
    ]
  },
  "mixins": [
    "multisolo.mixins.json",
    {
      "config": "multisolo.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_dependency_version}",
    "java": ">=${java_version}"
  }
}
